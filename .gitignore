__pycache__/
*.pyc
node_modules/
dist/
coverage/
# Blog branch run directories: extracted content and media, regenerated per ingest.
website_workflow/blog_runs/
.vitest/
# Generated host projects: source is regenerated, node_modules and .next are host-owned.
hosts/*/generated-host/

# Generated customer host projects (dry runs): regenerated each run.
customers/*/generated-host/

# Dry-run test output: tests/dry-run write to $TEMP/claude/..., which is ./claude/ when TEMP is unset.
/claude/
