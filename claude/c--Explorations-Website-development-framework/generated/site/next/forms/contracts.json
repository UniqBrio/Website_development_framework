{
  "note": "GENERATED form contracts as data: zod is not admitted, so no schema module is emitted. A host endpoint must validate these fields server-side.",
  "contracts": [
    {
      "kind": "checkout",
      "intent": "place an order request for listed products; payment is taken by a payment provider, never collected by this form",
      "legend": "Order request",
      "actionLabel": "Go to checkout",
      "submitLabel": "Submit order request",
      "fields": [
        {
          "name": "product",
          "label": "Product",
          "type": "select",
          "required": true,
          "options": [
            "FIXTURE-CUSTOM-ORTHOTIC",
            "FIXTURE-CUSTOM-WALKING-AID",
            "FIXTURE-STOCK-SUPPORT-A",
            "FIXTURE-STOCK-SUPPORT-B"
          ],
          "purpose": "which listed product is ordered"
        },
        {
          "name": "quantity",
          "label": "Quantity",
          "type": "number",
          "required": true,
          "min": 1,
          "purpose": "how many"
        },
        {
          "name": "name",
          "label": "Name",
          "type": "text",
          "required": true,
          "autocomplete": "name",
          "purpose": "who is asking"
        },
        {
          "name": "email",
          "label": "Email",
          "type": "email",
          "required": true,
          "autocomplete": "email",
          "purpose": "where the reply goes"
        },
        {
          "name": "delivery_address",
          "label": "Delivery address",
          "type": "textarea",
          "required": true,
          "autocomplete": "street-address",
          "purpose": "where the order goes"
        }
      ],
      "forbiddenFields": [
        "card_number",
        "card",
        "cvc",
        "cvv",
        "expiry",
        "card_expiry",
        "iban",
        "password"
      ],
      "validation": "browser constraint validation (required, type, min) with no JavaScript, mirrored by a zod schema a configured host endpoint must apply server-side",
      "endpoint": {
        "state": "unconfigured",
        "reason": "no checkout endpoint is configured in the host; the framework does not invent a backend"
      },
      "unconfiguredNotice": "Checkout is not connected yet, so orders cannot be placed on this site."
    }
  ]
}
